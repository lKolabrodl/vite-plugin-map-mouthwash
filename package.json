{
  "name": "vite-plugin-map-mouthwash",
  "version": "0.1.2",
  "description": "A Vite plugin that masks multilingual profanity in source-map comments without shifting mappings.",
  "homepage": "https://github.com/lKolabrodl/vite-plugin-map-mouthwash#readme",
  "bugs": {
    "url": "https://github.com/lKolabrodl/vite-plugin-map-mouthwash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lKolabrodl/vite-plugin-map-mouthwash.git"
  },
  "author": {
    "name": "lKolabrodl",
    "url": "https://github.com/lKolabrodl"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "docs",
    "examples/basic/README.md",
    "examples/basic/index.html",
    "examples/basic/inspect-map.mjs",
    "examples/basic/src",
    "examples/basic/vite.config.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "example:build": "vite build examples/basic --config examples/basic/vite.config.ts",
    "example:inspect": "node examples/basic/inspect-map.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:coverage && npm run build && npm run example:build && npm run example:inspect",
    "prepack": "npm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "rollup-plugin",
    "sourcemap",
    "source-map",
    "source-map-comments",
    "profanity",
    "profanity-filter",
    "multilingual",
    "typescript",
    "arabic",
    "english",
    "french",
    "russian",
    "spanish",
    "comments"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vite": ">=5.0.0 <9.0.0"
  },
  "dependencies": {
    "profanity-guard": "^1.1.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.5"
  },
  "license": "MIT"
}
